# ---------------------------------------------------------------------------
# The editor itself needs none of these. Every variable below is for the
# weekly blog pipeline; without them the site builds and runs exactly as it
# does today, and the cron endpoint refuses every request.
# ---------------------------------------------------------------------------

# Absolute URLs in metadata, sitemap and feed. Defaults to the production
# domain, so preview deployments are the only place this matters.
NEXT_PUBLIC_SITE_URL=https://actuallyfreepdfeditor.com

# --- required for the pipeline ---------------------------------------------
ANTHROPIC_API_KEY=
# Fine-grained PAT, contents:write plus pull-requests:write, scoped to this one repo.
GITHUB_TOKEN=
GITHUB_REPO=HalfMillennium/actuallyfreepdfeditor

# Vercel sends this as `Authorization: Bearer $CRON_SECRET`. The route refuses
# every request when it is unset — do not deploy the cron without it.
CRON_SECRET=
# Gates /blog/ops. Same fail-closed behaviour.
OPS_TOKEN=

# --- optional ---------------------------------------------------------------
# Slack or Discord incoming webhook for the end-of-run digest.
DIGEST_WEBHOOK_URL=

# Leave false for the first month. Runs open a PR against a blog/auto-<week>
# branch instead of committing to the default branch, so you read three PRs and
# learn what the reviewer is letting through before it ships unattended.
AUTO_MERGE=false

POSTS_PER_WEEK=3
MAX_DRAFTS_PER_RUN=6
# Checked after every model call; the run aborts and commits nothing above it.
MAX_RUN_COST_USD=2.00

# Two searches per run to check the SERP before proposing briefs. Off by
# default because it is a grounding nicety, not a dependency.
BLOG_WEB_SEARCH=false

# Overrides for the models. A stricter reviewer is the one worth paying for.
BLOG_AUTHOR_MODEL=claude-sonnet-5
BLOG_REVIEWER_MODEL=claude-sonnet-5
